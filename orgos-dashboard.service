[Unit]
Description=orgos Dashboard
After=network.target

[Service]
Type=simple
User=th
WorkingDirectory=/home/th/orgos/dashboard
Environment="PATH=/home/th/.nvm/versions/node/v26.3.0/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/th/.nvm/versions/node/v26.3.0/bin/npx next start -p 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

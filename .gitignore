# Secrets — never commit real keys
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
venv/
.venv/

# orgos runtime artifacts
_audit_logs/
.crewai_write_test
_orgos_memory/
config/.org-backups/
client_secret_*.json
google-*.json

# subagent-driven-development workflow scratch (task briefs, reports, ledger)
.superpowers/

# per-sprint git worktrees (legacy)
.sprints/

# per-team runtime state (workspaces, worktrees, boards, wikis, live events)
.orgos_teams/

# macOS metadata
.DS_Store
**/.DS_Store

# Runtime logs from benchmarking / experiments
*.log
!wiki/**/*.log

# Distribution archives (large; rebuild locally)
*.zip

# setuptools egg-info (regenerated on `pip install -e .`)
orgos.egg-info/PKG-INFO
orgos.egg-info/SOURCES.txt

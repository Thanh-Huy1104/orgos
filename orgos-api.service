[Unit]
Description=orgos API Server
After=network.target

[Service]
Type=simple
User=th
WorkingDirectory=/home/th/orgos
Environment="PATH=/home/th/orgos/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/home/th/orgos"
EnvironmentFile=/home/th/orgos/.env
ExecStart=/home/th/orgos/venv/bin/python -m uvicorn orgos.api:app --host 0.0.0.0 --port 8420
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

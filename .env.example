# orgos — example environment.
# Copy to .env and fill in, then load it into your shell before running:
#
#   cp .env.example .env
#   set -a; . ./.env; set +a            # export everything in .env
#   python examples/quant_pair_scanner.py
#
# (.env is gitignored — never commit real keys.)

# ── Provider keys ─────────────────────────────────────────────────────────────
# Set the key(s) for whichever provider your chosen models use. You only need
# the ones referenced by the model strings below.

# OpenAI — for gpt-* models.            Get one: platform.openai.com → API keys
OPENAI_API_KEY=sk-...

# Anthropic — for anthropic/claude-* .  Get one: console.anthropic.com → API keys
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini — for gemini/* models.  Get one: aistudio.google.com → Get API key
# GEMINI_API_KEY=...

# ── Web search (research department) ──────────────────────────────────────────
# The internet MCP auto-selects whichever key is present, in priority order,
# falling through on error/empty. Without any key it uses DuckDuckGo, which is
# rate-limited and often returns nothing — set TAVILY_API_KEY for reliability.
# Tavily — agent-native search (primary). Free ~1k/mo.   Get one: app.tavily.com
TAVILY_API_KEY=tvly-...
# Optional extra fallbacks (uncomment + set if you want them):
# Brave  — independent index.                            Get one: api.search.brave.com
# BRAVE_API_KEY=...
# Serper — Google SERP results.                          Get one: serper.dev
# SERPER_API_KEY=...

# ── Market data (quant desk) ──────────────────────────────────────────────────
# EOD prices for the cointegration engine. Tiingo primary (CRSP-style adjusted
# close, correct on the free tier — the only series safe for cointegration);
# yfinance is a no-key dev fallback. Free tier fits a scoped liquid universe.
TIINGO_API_KEY=...                                    # Get one: tiingo.com (free)
# Optional future cross-check (institutional Layer-1, free 5 req/min):
# POLYGON_API_KEY=...                                  # Get one: polygon.io

# ── Model selection (per role; optimize cost/quality by swapping these) ────────
# litellm needs a provider prefix for non-OpenAI models ('anthropic/...',
# 'gemini/...'). Bare 'gpt-*' strings default to OpenAI.

# Cheapest default (all OpenAI mini):
ORGOS_SCANNER_MODEL=gpt-4o-mini
ORGOS_VALIDATOR_MODEL=gpt-4o-mini
ORGOS_SUPERVISOR_MODEL=gpt-4o

# Optimized mix (uncomment + set ANTHROPIC_API_KEY): cheap reliable workers,
# stronger supervisor for delegation/synthesis.
# ORGOS_SCANNER_MODEL=anthropic/claude-haiku-4-5
# ORGOS_VALIDATOR_MODEL=anthropic/claude-haiku-4-5
# ORGOS_SUPERVISOR_MODEL=anthropic/claude-sonnet-4-6

# ── Smoke harness (independent of the role models above) ──────────────────────
# Model used by smoke_phase1.py for its live runtime checks.
ORGOS_SMOKE_MODEL=gpt-4o-mini
